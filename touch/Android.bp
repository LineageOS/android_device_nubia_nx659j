cc_binary {
    name: "vendor.lineage.touch-service.nx659j",
    vintf_fragments: ["vendor.lineage.touch-service.nx659j.xml"],
    init_rc: ["vendor.lineage.touch-service.nx659j.rc"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "HighTouchPollingRate.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}
